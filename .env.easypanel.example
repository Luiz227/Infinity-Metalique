# Endereco HTTPS configurado no dominio do servico frontend.
APP_URL=https://infinity.seudominio.com.br

# Gere com: php artisan key:generate --show
APP_KEY=base64:SUBSTITUA_PELA_CHAVE_GERADA

DB_DATABASE=infinity_metalique
DB_USERNAME=infinity
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
DB_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

# Gere uma chave aleatoria longa, sem espacos e sem o caractere $.
ONLYOFFICE_JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE
