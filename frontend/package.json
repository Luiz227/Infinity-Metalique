{
  "name": "metalique-infinity-frontend",
  "productName": "Metalique Infinity",
  "private": true,
  "version": "0.1.0",
  "description": "Cliente desktop do sistema Metalique Infinity.",
  "author": "Metalique",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "icons": "node scripts/generate-icons.cjs",
    "desktop": "node electron/launch.cjs",
    "desktop:dev": "node electron/dev.cjs",
    "desktop:make": "node scripts/desktop-build.cjs preview",
    "desktop:release": "node scripts/desktop-build.cjs production",
    "desktop:release:check": "node scripts/desktop-build.cjs production --check",
    "desktop:version": "node scripts/desktop-build.cjs version",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  }
}
